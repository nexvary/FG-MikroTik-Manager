<Window x:Class="FG.MTM.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="FG MTM — MikroTik Manager" Width="1180" Height="760" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" Background="#0B0D10" Foreground="#EBEEF3">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="14,10"/><Setter Property="Background" Value="#202B38"/><Setter Property="Foreground" Value="#EBEEF3"/><Setter Property="BorderBrush" Value="#8291A3"/></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#18202A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#8291A3"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="#18202A"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="DataGrid"><Setter Property="IsReadOnly" Value="True"/><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="Background" Value="#18202A"/><Setter Property="Foreground" Value="#101820"/><Setter Property="RowBackground" Value="#DCE2EA"/><Setter Property="AlternatingRowBackground" Value="#C3CEDB"/><Setter Property="MinHeight" Value="160"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#11151A" BorderBrush="#AAB2BD" BorderThickness="0,0,1,0">
   <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="FG MTM" FontSize="28" FontWeight="Bold"/><TextBlock Text="MikroTik Manager" Margin="0,0,0,16"/><Button x:Name="LanguageButton" Content="العربية" Click="ToggleLanguage"/><CheckBox x:Name="AdvancedMode" Content="Advanced mode" Margin="0,12" Checked="ModeChanged" Unchecked="ModeChanged" Foreground="White"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Navigation"/></ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel><Button x:Name="BackButton" Content="← Back" Click="GoBack" DockPanel.Dock="Left" Margin="0,0,16,0"/><TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <TextBlock x:Name="Status" Grid.Row="1" Margin="0,12" TextWrapping="Wrap" Foreground="#72D7CB"/>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <StackPanel x:Name="OverviewPanel"><TextBlock x:Name="OverviewText" FontSize="18" TextWrapping="Wrap"/><Button x:Name="ConnectShortcut" Content="Connect to FG Server" Click="OpenSettings" HorizontalAlignment="Left" Margin="0,20"/></StackPanel>
     <StackPanel x:Name="SettingsPanel" Visibility="Collapsed" MaxWidth="580" HorizontalAlignment="Stretch">
      <TextBlock x:Name="UrlLabel" Text="FG Server HTTPS address"/><TextBox x:Name="ServerUrl" FlowDirection="LeftToRight"/>
      <TextBlock x:Name="TenantLabel" Text="Tenant"/><TextBox x:Name="Tenant" FlowDirection="LeftToRight"/>
      <TextBlock x:Name="BranchLabel" Text="Branch"/><TextBox x:Name="Branch" FlowDirection="LeftToRight"/>
      <TextBlock x:Name="UsernameLabel" Text="Username"/><TextBox x:Name="Username" FlowDirection="LeftToRight"/>
      <TextBlock x:Name="PasswordLabel" Text="Password"/><PasswordBox x:Name="Password" FlowDirection="LeftToRight"/>
      <WrapPanel><Button x:Name="LoginButton" Content="Login" Click="Login" Margin="0,4,12,4"/><Button x:Name="LogoutButton" Content="Logout" Click="Logout"/></WrapPanel>
      <TextBlock x:Name="ScopeText" Margin="0,12" TextWrapping="Wrap"/>
     </StackPanel>
     <StackPanel x:Name="RouterPanel" Visibility="Collapsed">
      <TextBlock x:Name="RouterNotice" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBlock x:Name="RouterUrlLabel" Text="Router HTTPS address"/><TextBox x:Name="RouterUrl" FlowDirection="LeftToRight"/>
      <TextBlock x:Name="RouterUserLabel" Text="Router username"/><TextBox x:Name="RouterUsername" FlowDirection="LeftToRight"/>
      <TextBlock x:Name="RouterPasswordLabel" Text="Router password"/><PasswordBox x:Name="RouterPassword" FlowDirection="LeftToRight"/>
      <WrapPanel><Button x:Name="RouterConnectButton" Content="Connect" Click="ConnectRouter" Margin="0,4,12,4"/><Button x:Name="RouterDisconnectButton" Content="Disconnect" Click="DisconnectRouter" Margin="0,4,12,4"/><Button x:Name="RouterRefreshButton" Content="Refresh" Click="RefreshRouter"/></WrapPanel>
      <ComboBox x:Name="RouterModules" SelectionChanged="RouterModuleChanged" Padding="8" Margin="0,12"/>
      <TextBlock x:Name="RouterState" TextWrapping="Wrap" Margin="0,8"/>
      <DataGrid x:Name="RouterGrid" AutoGenerateColumns="True" MaxHeight="420"/>
     </StackPanel>
     <StackPanel x:Name="RadiusPanel" Visibility="Collapsed">
      <TextBlock x:Name="RadiusNotice" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <WrapPanel><Button x:Name="RefreshButton" Content="Refresh" Click="Refresh" Margin="0,0,12,8"/><CheckBox x:Name="ActiveOnly" Content="Active only" Foreground="White" Margin="0,10,12,0" Checked="FilterChanged" Unchecked="FilterChanged"/><CheckBox x:Name="ExpiredOnly" Content="Expired" Foreground="White" Margin="0,10,12,0" Checked="FilterChanged" Unchecked="FilterChanged"/><CheckBox x:Name="DisabledOnly" Content="Disabled" Foreground="White" Margin="0,10" Checked="FilterChanged" Unchecked="FilterChanged"/></WrapPanel>
      <TextBlock x:Name="SearchLabel" Text="Search username / NAS / session ID"/><TextBox x:Name="Search" TextChanged="SearchChanged"/>
      <TextBlock x:Name="UsersLabel" Text="Users" Margin="0,8"/>
      <DataGrid x:Name="UsersGrid" MaxHeight="300"><DataGrid.Columns>
       <DataGridTextColumn Header="Username" Binding="{Binding Username}"/><DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}"/><DataGridTextColumn Header="Expires" Binding="{Binding Expires}"/><DataGridTextColumn Header="Active sessions" Binding="{Binding ActiveSessions}"/><DataGridTextColumn Header="Seconds" Binding="{Binding Seconds}"/><DataGridTextColumn Header="Upload bytes" Binding="{Binding InputOctets}"/><DataGridTextColumn Header="Download bytes" Binding="{Binding OutputOctets}"/><DataGridTextColumn Header="Total bytes" Binding="{Binding TotalUsage}"/>
      </DataGrid.Columns></DataGrid>
      <TextBlock x:Name="SessionsLabel" Text="Sessions" Margin="0,16,0,8"/>
      <DataGrid x:Name="SessionsGrid" MaxHeight="300"><DataGrid.Columns>
       <DataGridTextColumn Header="Username" Binding="{Binding Username}"/><DataGridTextColumn Header="NAS" Binding="{Binding Nas}"/><DataGridTextColumn Header="Session ID" Binding="{Binding Session}"/><DataGridCheckBoxColumn Header="Stopped" Binding="{Binding Stopped}"/><DataGridTextColumn Header="Seconds" Binding="{Binding Seconds}"/><DataGridTextColumn Header="Upload bytes" Binding="{Binding InputOctets}"/><DataGridTextColumn Header="Download bytes" Binding="{Binding OutputOctets}"/><DataGridTextColumn Header="Total bytes" Binding="{Binding TotalUsage}"/>
      </DataGrid.Columns></DataGrid>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
